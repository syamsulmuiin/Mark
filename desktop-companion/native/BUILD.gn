# Build from an official WebRTC source checkout: //mark_apm:mark_webrtc_apm
shared_library("mark_webrtc_apm") {
  sources = [ "mark_webrtc_apm.cc" ]
  deps = [
    "//modules/audio_processing",
    "//api/environment:environment_factory",
    "//api/audio:builtin_audio_processing_builder",
  ]
  # Remove Chromium-only clang plugins inherited from the toolchain.
  configs -= [ "//build/config/clang:find_bad_constructs" ]
}
